generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SeasoningPowder {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  description        String?
  imageUrl           String?
  brand              String?
  ingredients        String?
  flavorProfile      String?
  mainUse            String?
  pairingSuggestions String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recipes            RecipeSeasoningPowder[]
}

model Recipe {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  photoUrl      String?
  ingredients   String?
  steps         String?
  cookingTime   Int?
  difficulty    String?
  isFavorited   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seasoningPowders RecipeSeasoningPowder[]
}

model RecipeSeasoningPowder {
  recipeId          Int
  seasoningPowderId Int
  recipe            Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  seasoningPowder   SeasoningPowder @relation(fields: [seasoningPowderId], references: [id], onDelete: Cascade)

  @@id([recipeId, seasoningPowderId])
}
